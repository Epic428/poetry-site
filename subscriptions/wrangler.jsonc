{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "nocturne-subscriptions",
  "main": "./worker.ts",
  "compatibility_date": "2026-11-05",
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nocturne-subscriptions",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ],
  "vars": {
    "PUBLIC_SITE_URL": "https://nocturnepoetry.com",
    "RESEND_FROM_EMAIL": "Nocturne <poems@nocturnepoetry.com>"
  }
}
